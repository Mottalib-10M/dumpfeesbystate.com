---
/** Renders one tool with its page defaults: the full load calculator (`dump`), the EPA landfill finder (`finder`) or a mini-spec (`mini:<spec>`). */
import DumpCalc from './calc/DumpCalc';
import LandfillFinder from './calc/LandfillFinder';
import MiniSim from './calc/MiniSim';
import { route } from '../i18n/routes';
import { getSpec } from '../lib/mini-specs';
import { DUMPS } from '../lib/engine/fees';
import { PAGES } from '../lib/guides';
import type { ToolDef } from '../lib/guide-types';
interface Props { tool: ToolDef; primary?: boolean; idPrefix?: string }
const { tool, primary = false, idPrefix } = Astro.props;
const props = (tool.props ?? {}) as Record<string, any>;
const methodHref = route('method', 'en');
const kind = tool.kind;
const mini = kind.startsWith('mini:') ? kind.slice(5) : null;
const spec = mini ? getSpec(mini) : null;
const href = spec?.ctaPage ? route(spec.ctaPage, 'en') : undefined;
const numDefaults: Record<string, number> = {};
for (const [k, v] of Object.entries(props)) if (typeof v === 'number') numDefaults[k] = v;
// Finder: per state, the area pages whose schedules we read (else the calculator preset on the facility).
const schedules: Record<string, Array<{ name: string; href: string }>> = {};
if (kind === 'finder') for (const f of DUMPS) {
  const pg = PAGES.find((p) => p.group === 'metro' && (p.tool?.props?.facility === f.id || (p.tool?.props?.also as string | undefined)?.split(',').includes(f.id)));
  (schedules[f.state] ??= []).push({ name: f.name, href: pg ? route(pg.id, "en") : f.url });
}
---
{kind === 'dump' && <DumpCalc client:load {...props} methodHref={methodHref} weightHref={route('truckload-dump-cost', 'en')} idPrefix={idPrefix ?? 'dc'} />}
{kind === 'finder' && <LandfillFinder client:load state={props.state ?? 'UT'} schedules={schedules} idPrefix={idPrefix ?? 'lf'} />}
{mini && <MiniSim client:load kind={mini} href={href} defaults={numDefaults} primary={primary} idPrefix={idPrefix ?? (primary ? 'p' : 'm')} />}
