---
/** Embeddable calculator (iframe): no navigation, noindex, out of the sitemap (astro.config). */
import '../../styles/global.css';
import DumpCalc from '../../components/calc/DumpCalc';
import { SITE_URL, SITE_NAMES } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { t } from '../../i18n/ui';
---
<!doctype html>
<html lang="en-US">
  <head>
    <meta charset="UTF-8" /><meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Dump fee calculator (widget)</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={`${SITE_URL}/en/`} />
  </head>
  <body class="bg-white p-2 text-navy-900">
    <DumpCalc client:load methodHref={`${SITE_URL}${route('method', 'en')}`} idPrefix="w" />
    <p class="mt-2 text-center text-xs text-navy-600"><a href={`${SITE_URL}/en/`} target="_blank" rel="noopener" class="underline">{SITE_NAMES.en}</a> · Independent tool by Radif Partners, not a waste hauler or a landfill operator · worked out in your browser</p>
    <p class="mt-1 text-center text-xs text-navy-600">{t('en').attribution}</p>
  </body>
</html>
